---
import BaseLayout from '../layouts/BaseLayout.astro';

import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
import Grid from '../components/Grid.astro';
---

<BaseLayout title="Sobre mí | Jafet Lopez" description="Sobre Jafet Lopez - Desarrollador de Software">
	<div class="stack gap-20">
		<main class="wrapper about">
			<Hero
				title="Sobre mí"
				tagline="Gracias por pasar por aquí. Lee a continuación para conocer más sobre mí y mi trayectoria."
			>
				<img
					width="1553"
					height="873"
					src="/assets/CodeReddit.webp"
					alt="Jafet Lopez trabajando con un colega"
				/>
			</Hero>

			<section>
				<h2 class="section-title">Sobre mi</h2>
				<div class="content">
					<p>
						Desarrollador de Software con más de un año de experiencia, orientado activamente hacia el Backend, la
						Infraestructura y la Arquitectura. Me dedico a diseñar soluciones modulares, escalables y eficientes, traduciendo
						reglas de negocio complejas en sistemas robustos. Tengo experiencia demostrable reduciendo deuda técnica,
						refactorizando código legacy hacia estándares modernos y mitigando limitaciones arquitectónicas para maximizar
						el valor entregado a la empresa.
					</p>
					<ul>
						<li>
							Lidero la refactorización progresiva de sistemas legacy hacia arquitecturas modernas y estables.
						</li>
						<li>
							Reduzco activamente la deuda técnica mediante la optimización de bloques de código.
						</li>
						<li>
							Analizo e integro requerimientos empresariales, traduciendo necesidades operativas en soluciones escalables.
						</li>
					</ul>
				</div>
			</section>
			<section>
				<h2 class="section-title">Habilidades</h2>
				<div class="content">
					<div>
						<h3 class="section-subtitle">Backend & Arquitectura</h3>
						<img class="img-skill"
							src="https://skillicons.dev/icons?i=java,spring,dotnet,nodejs&perline=7"
							alt="Backend y Arquitectura: Java, Spring Boot, C# .NET, Node.js"
						/>
					</div>
					<div>
						<h3 class="section-subtitle">Infraestructura & Datos</h3>
						<img class="img-skill"
							src="https://skillicons.dev/icons?i=docker,kafka,postgresql,mongodb,elasticsearch&perline=7"
							alt="Infraestructura: Docker, Kafka, PostgreSQL, MongoDB, ELK Stack"
						/>
					</div>
					<div>
						<h3 class="section-subtitle">Frontend</h3>
						<img class="img-skill"
							src="https://skillicons.dev/icons?i=javascript,typescript,angular,html,css&perline=7"
							alt="Frontend: JavaScript, TypeScript, Angular, HTML5, CSS3"
						/>
					</div>
					<div>
						<h3 class="section-subtitle">Herramientas & Metodologías</h3>
						<img class="img-skill"
							src="https://skillicons.dev/icons?i=git,github,gitlab,vscode,idea,postman&perline=7"
							alt="Herramientas: Git, GitHub, GitLab, VS Code, IntelliJ IDEA, Postman"
						/>
					</div>
					<div>
						<h3 class="section-subtitle">Idiomas</h3>
						<p class="languages">Español (Nativo) | Inglés (B1 - Técnico fluido)</p>
					</div>
				</div>
			</section>
			<section>
				<h2 class="section-title">Educación</h2>
				<div class="content">
					<div class="gallery">
						<Grid variant="offset">
							{
								[
									{
										title: 'Ingeniería Telemática',
										institution: 'Universidad Distrital Francisco José de Caldas',
										year: 'Ene/2025 – Presente',
									},
									{
										title: 'Tecnólogo en Sistematización de Datos',
										institution: 'Universidad Distrital Francisco José de Caldas',
										year: 'Nov/2021 – Nov/2025',
									},
									{
										title: 'Despliegue de Aplicaciones en Docker',
										institution: 'SENA',
										year: '2023',
									},
									{
										title: 'Curso de Typescript',
										institution: 'CodigoFacilito',
										year: '2024',
									},
									{
										title: 'Bootcamp Intensivo Azure AI 102',
										institution: 'CodigoFacilito',
										year: '2024',
									}
								].map(({ title, year, institution }) => (
									<div class="education-card">
										<div>
											<p><strong>{title}</strong></p>
											<p>{institution}</p>
											<p>{year}</p>
										</div>
									</div>
								))
							}
						</Grid>
					</div>
				</div>
			</section>
		</main>
		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.about {
		display: flex;
		flex-direction: column;
		gap: 3.5rem;
	}

	img {
		margin-top: 1.5rem;
		border-radius: 1.5rem;
		box-shadow: var(--shadow-md);
	}

	section {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		color: var(--gray-200);
	}

	.img-skill {
		border-radius: 0;
		box-shadow: none;
	}

	.section-title {
		grid-column-start: 1;
		font-size: var(--text-xl);
		color: var(--gray-0);
	}
	.section-subtitle {
		font-size: var(--text-lg);
		color: var(--gray-0);
	}

	.content {
		grid-column: 2 / 4;
	}

	.content :global(a) {
		text-decoration: 1px solid underline transparent;
		text-underline-offset: 0.25em;
		transition: text-decoration-color var(--theme-transition);
	}

	.content :global(a:hover),
	.content :global(a:focus) {
		text-decoration-color: currentColor;
	}
	.education-card {
		display: flex;
		height: 7rem;
		justify-content: center;
		align-items: center;
		text-align: center;
		border: 1px solid var(--gray-800);
		border-radius: 1.5rem;
		color: var(--gray-300);
		background: var(--gradient-subtle);
		box-shadow: var(--shadow-sm);
	}

	.languages {
		color: var(--gray-200);
		font-size: var(--text-lg);
	}

	@media (min-width: 50em) {
		.about {
			display: grid;
			grid-template-columns: 1fr 60% 1fr;
		}

		.about > :global(:first-child) {
			grid-column-start: 2;
		}

		section {
			display: contents;
			font-size: var(--text-lg);
		}
		.gallery {
			grid-area: gallery;
		}
		.education-card {
			border-radius: 1.5rem;
			height: 9.5rem;
		}
	}
</style>
